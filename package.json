{
  "name": "stride-ai",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "build:web": "expo export --platform web --max-workers 2 --output-dir web-dist",
